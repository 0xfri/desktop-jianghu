{
  "name": "dsh-desktop-jianghu",
  "version": "0.1.0",
  "description": "Desktop Jianghu — a persistent wuxia text game for the DeepSeek Harness desktop: idle cultivation, turn-based duels, sect storylines, quests, equipment and legendary weapons. Level cap 100.",
  "type": "module",
  "license": "MIT",
  "author": "0xfri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xfri/desktop-jianghu.git"
  },
  "homepage": "https://github.com/0xfri/desktop-jianghu",
  "bugs": {
    "url": "https://github.com/0xfri/desktop-jianghu/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "desktop-pet",
    "wuxia",
    "text-game",
    "idle-game",
    "react"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node tests/smoke.cjs",
    "dev:preview": "node dev/serve.cjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
